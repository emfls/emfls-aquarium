---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { species } from '../../data/species';
const categories = [...new Set(species.map((item) => item.category))]; const difficulties = [...new Set(species.map((item) => item.careDifficulty))];
---
<BaseLayout title="생물 도감" description="관상어와 수중 생물의 핵심 사육 정보를 검색하고 조건별로 탐색하는 도감."><div class="container page-intro"><span class="eyebrow">SPECIES / INDEX</span><h1>생물 도감</h1><p>이름과 학명으로 찾거나 분류·난이도·수온·수조 크기 조건을 조합해 탐색하세요.</p></div><section class="section species-explorer"><div class="container"><form class="species-filters" id="species-filters"><div class="search-field"><label for="species-search">생물 검색</label><input id="species-search" type="search" autocomplete="off" placeholder="이름, 영문명, 학명으로 검색" /></div><label for="category-filter">분류<select id="category-filter"><option value="all">전체</option>{categories.map((category) => <option value={category}>{category}</option>)}</select></label><label for="care-filter">사육 난이도<select id="care-filter"><option value="all">전체</option>{difficulties.map((difficulty) => <option value={difficulty}>{difficulty}</option>)}</select></label><label for="temperature-filter">수온 조건<select id="temperature-filter"><option value="all">전체</option><option value="cool">22°C 이하 포함</option><option value="tropical">25°C 포함</option><option value="warm">28°C 이상 포함</option></select></label><label for="tank-filter">최소 수조<select id="tank-filter"><option value="all">전체</option><option value="30">30L 이하</option><option value="60">60L 이하</option><option value="100">100L 이하</option><option value="over100">100L 초과</option></select></label><button type="reset" class="filter-reset">모든 조건 초기화</button></form><div class="results-toolbar"><p id="species-result-count" aria-live="polite">10종 중 10종</p></div><div class="cards" id="species-grid">{species.map((item) => <a class="card species-result-card" data-name={item.name} data-search={`${item.name} ${item.commonNameEn} ${item.scientificName} ${item.summary} ${item.category}`} data-category={item.category} data-care={item.careDifficulty} data-temp-min={item.temperatureC.min} data-temp-max={item.temperatureC.max} data-tank={item.minimumTankLiters} href={`/species/${item.slug}/`}><div class="card-top"><span>{item.category}</span><span>{item.minimumTankLiters} L+</span></div><h3>{item.name}</h3><div class="latin">{item.commonNameEn} · {item.scientificName}</div><p>{item.summary}</p><div class="metrics"><span class="metric">TEMP<strong>{item.temperatureC.min}–{item.temperatureC.max}°C</strong></span><span class="metric">SIZE<strong>{item.adultSizeCm.min}–{item.adultSizeCm.max} cm</strong></span><span class="metric">CARE<strong>{item.careDifficulty}</strong></span></div></a>)}</div><div class="empty-state" id="species-empty" hidden><h2>조건에 맞는 생물을 찾지 못했습니다.</h2><p>검색어나 필터 조건을 바꿔보세요.</p><button type="button" class="filter-reset" id="empty-reset">필터 초기화</button></div></div></section><script>import type { Species } from '../../data/species'; import { filterSpecies } from '../../lib/speciesSearch'; const form = document.querySelector('#species-filters') as HTMLFormElement; const search = document.querySelector('#species-search') as HTMLInputElement; const category = document.querySelector('#category-filter') as HTMLSelectElement; const care = document.querySelector('#care-filter') as HTMLSelectElement; const temperature = document.querySelector('#temperature-filter') as HTMLSelectElement; const tank = document.querySelector('#tank-filter') as HTMLSelectElement; const cards = Array.from(document.querySelectorAll<HTMLElement>('.species-result-card')); const count = document.querySelector('#species-result-count') as HTMLElement; const empty = document.querySelector('#species-empty') as HTMLElement; const emptyReset = document.querySelector('#empty-reset') as HTMLButtonElement; const data = cards.map((card) => ({ name: card.dataset.name || '', commonNameEn: card.dataset.search?.split(' ')[1] || '', scientificName: '', category: card.dataset.category || '', summary: card.dataset.search || '', adultSizeCm:{min:0,max:0},temperatureC:{min:Number(card.dataset.tempMin),max:Number(card.dataset.tempMax)},ph:{min:0,max:0},temperament:'',minimumTankLiters:Number(card.dataset.tank),diet:[],activityZone:'',breedingDifficulty:'쉬움',compatibilityDifficulty:'쉬움',careDifficulty:card.dataset.care || '쉬움',lifespanYears:{min:0,max:0},cautions:[],recommendedFor:'',slug:'',sources:[],recommendedKeeping:'',breedingNotes:'' })) as Species[]; const params = new URLSearchParams(location.search); search.value = params.get('q') || ''; function update(){ const selected = filterSpecies(data,{query:search.value,category:category.value,careDifficulty:care.value,temperatureBand:temperature.value,tankLimit:tank.value}); const names = new Set(selected.map((item) => item.name)); cards.forEach((card) => { card.hidden = !names.has(card.dataset.name || ''); }); count.textContent = `10종 중 ${selected.length}종`; empty.hidden = selected.length > 0; } function reset(){ search.value=''; category.value='all'; care.value='all'; temperature.value='all'; tank.value='all'; update(); } form.addEventListener('input',update); form.addEventListener('reset',(event)=>{event.preventDefault();reset();}); emptyReset.addEventListener('click',reset); update();</script></BaseLayout>
