---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { guides } from '../../data/guides'; import { species } from '../../data/species';
export function getStaticPaths(){ return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } })); }
const { guide } = Astro.props;
const relatedSpecies = species.filter((item) => guide.relatedSpecies.includes(item.slug));
const relatedGuides = guides.filter((item) => guide.relatedGuides.includes(item.slug));
---
<BaseLayout title={`${guide.title} 가이드`} description={guide.description}><div class="container page-intro guide-intro"><a class="back-link" href="/guides/">← 관리 가이드</a><span class="eyebrow">{guide.category}</span><h1>{guide.title}</h1><p>{guide.description}</p><small class="updated">업데이트 {guide.updatedAt}</small></div><article class="container manual-layout"><aside class="quick-answer"><span class="eyebrow">QUICK ANSWER</span><p>{guide.quickAnswer}</p></aside><div class="manual-content"><section><span class="eyebrow">01 / Context</span><h2>왜 중요한가</h2><p>{guide.why}</p></section><section><span class="eyebrow">02 / Principles</span><h2>기본 원칙</h2><ul class="principles">{guide.principles.map((item) => <li>{item}</li>)}</ul></section>{guide.steps.length > 0 && <section><span class="eyebrow">03 / Practice</span><h2>실행 방법</h2><ol class="step-list">{guide.steps.map((step, index) => <li><div class="step-number">{String(index + 1).padStart(2, '0')}</div><div><h3>{step.title}</h3><p>{step.body}</p></div></li>)}</ol></section>}<section class="reference-grid"><div><span class="eyebrow">04 / Reference</span><h2>판단 기준</h2><ul>{guide.checks.map((item) => <li>{item}</li>)}</ul></div><div class="caution-box"><span class="eyebrow">CAUTION</span><h2>흔한 실수</h2><ul>{guide.mistakes.map((item) => <li>{item}</li>)}</ul><p><strong>문제가 생겼을 때:</strong> {guide.whenConcerned}</p></div></section><section><span class="eyebrow">05 / Related</span><h2>관련 정보</h2>{relatedSpecies.length > 0 && <div class="related-links"><h3>관련 생물</h3>{relatedSpecies.map((item) => <a href={`/species/${item.slug}/`}>{item.name} <span>{item.scientificName} ↗</span></a>)}</div>}{relatedGuides.length > 0 && <div class="related-links"><h3>관련 가이드</h3>{relatedGuides.map((item) => <a href={`/guides/${item.slug}/`}>{item.title} <span>읽기 ↗</span></a>)}</div>}</section><section class="sources-section"><span class="eyebrow">REFERENCES</span><h2>참고 자료</h2><ul class="sources">{guide.sources.map((source) => <li><a href={source.url} target="_blank" rel="noreferrer">{source.title} ↗</a><small>확인일 {source.accessedAt}</small></li>)}</ul></section></div></article></BaseLayout>
