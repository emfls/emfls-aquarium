---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="수조 물량 계산기" description="수조의 가로·세로·높이와 실사용 비율로 예상 물량을 계산하는 도구."><div class="container page-intro tool-intro"><a class="back-link" href="/tools/">← Aquarium Tools</a><span class="eyebrow">TOOLS / TANK VOLUME</span><h1>수조 물량 계산기</h1><p>수조 치수를 입력해 이론상 총 용량과 실제 관리에 가까운 예상 물량을 확인하세요.</p></div><section class="section calculator-section"><div class="container calculator-layout"><form class="calculator-panel" id="tank-volume-form"><fieldset><legend>수조 치수</legend><div class="input-grid"><label for="width">가로 <span>cm</span><input id="width" name="width" type="number" inputmode="decimal" min="0.1" max="1000" step="0.1" value="60" required /></label><label for="depth">세로 <span>cm</span><input id="depth" name="depth" type="number" inputmode="decimal" min="0.1" max="1000" step="0.1" value="30" required /></label><label for="height">높이 <span>cm</span><input id="height" name="height" type="number" inputmode="decimal" min="0.1" max="1000" step="0.1" value="35" required /></label></div></fieldset><fieldset><legend>실사용 비율 <output id="usable-percent-value" for="usable-percent">85%</output></legend><p class="field-help">바닥재·장식물·수면 높이를 고려한 추정 비율입니다.</p><input id="usable-percent" name="usablePercent" type="range" min="1" max="100" step="1" value="85" /></fieldset><p class="form-error" id="form-error" role="alert" hidden>0보다 큰 치수와 1–100% 사이의 비율을 입력해 주세요.</p></form><div class="results-panel" aria-live="polite"><span class="eyebrow">CALCULATION / RESULT</span><div class="result-card"><span>이론상 총 용량</span><strong id="theoretical-result">63.0 L</strong><small>수조가 물로 완전히 채워진 경우</small></div><div class="result-card result-card-accent"><span>예상 실제 물량</span><strong id="usable-result">53.6 L</strong><small id="usable-ml-result">약 53,550 mL · 실사용 비율 85%</small></div></div></div></section><section class="section calculator-notes"><div class="container note-grid"><div><span class="eyebrow">FORMULA</span><h2>계산 방식</h2><p>가로(cm) × 세로(cm) × 높이(cm) ÷ 1000 = 이론상 총 용량(L)</p><p>실제 물량은 바닥재, 장식물, 유리 두께, 수면을 채우지 않는 여유 공간에 따라 줄어드는 추정치입니다. 가능하면 외부 치수보다 내부 치수를 사용하세요.</p></div><div class="example-box"><span class="eyebrow">EXAMPLE</span><h2>60 × 30 × 35 cm</h2><p>이론상 <strong>63.0 L</strong><br />실사용 비율 85% <strong>약 53.6 L</strong></p></div></div></section><section class="section related-tools"><div class="container"><span class="eyebrow">RELATED / CARE</span><h2>함께 읽기</h2><div class="page-actions"><a href="/guides/aquarium-cycling/">물잡이</a><a href="/guides/water-change/">환수</a><a href="/guides/filtration/">여과</a></div></div></section><script>import { calculateTankVolume } from '../../lib/tankVolume'; const getEl = (id: string) => document.querySelector(`#${id}`) as HTMLInputElement; const form = getEl('tank-volume-form'); const percentValue = getEl('usable-percent-value'); const theoretical = getEl('theoretical-result'); const usable = getEl('usable-result'); const ml = getEl('usable-ml-result'); const error = getEl('form-error'); function update(){ const get = (id: string) => Number(getEl(id).value); const usablePercent = get('usable-percent'); percentValue.textContent = `${usablePercent}%`; const result = calculateTankVolume({ width: get('width'), depth: get('depth'), height: get('height'), usablePercent }); if (!result) { error.hidden = false; theoretical.textContent = '—'; usable.textContent = '—'; ml.textContent = '입력값을 확인해 주세요.'; return; } error.hidden = true; theoretical.textContent = `${result.theoreticalLiters.toFixed(1)} L`; usable.textContent = `${result.usableLiters.toFixed(1)} L`; ml.textContent = `약 ${Math.round(result.usableLiters * 1000).toLocaleString()} mL · 실사용 비율 ${usablePercent}%`; } form.addEventListener('input', update); update();</script></BaseLayout>
